# ═══════════════════════════════════════════════════════════════════════
# TrainerOS — Environment Variables Example
# 
# Copia este archivo a `.env.local` y completa con tus credenciales de Supabase.
# Obtén estos valores en: https://supabase.com/dashboard/project/_/settings/api
# ═══════════════════════════════════════════════════════════════════════

# URL de tu proyecto de Supabase (Project URL)
# Ejemplo: https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=https://tu-proyecto-id.supabase.co

# Clave pública anónima de tu proyecto (Project API Anon Key)
# Ejemplo: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Botón "Entrar con Google". Ya está activado en el proyecto de Supabase.
# Si usás otro proyecto sin Google configurado, poné false.
VITE_GOOGLE_SIGN_IN=true
